{
  "name": "asset-ledger",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "prepare": "node scripts/prepare-ledger.mjs",
    "install:ci": "pnpm install --frozen-lockfile",
    "dev": "node scripts/configure.mjs && next dev --hostname 127.0.0.1 --port 5173",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1",
    "setup": "node scripts/configure.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:smoke": "node scripts/smoke-self-host.mjs",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "class-variance-authority": "catalog:",
    "clsx": "catalog:",
    "drizzle-orm": "catalog:",
    "ethers": "6.17.0",
    "lucide-react": "catalog:",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "radix-ui": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "recharts": "catalog:",
    "sonner": "^2.0.8",
    "tailwind-merge": "catalog:",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "drizzle-kit": "catalog:",
    "eslint": "catalog:",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "catalog:",
    "tw-animate-css": "catalog:",
    "typescript": "catalog:"
  },
  "type": "module"
}
