{
  "name": "asset-ledger",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "prepare": "node scripts/prepare-ledger.mjs",
    "install:ci": "npm ci",
    "dev": "node scripts/configure.mjs && next dev --hostname 127.0.0.1 --port 5173",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1",
    "setup": "node scripts/configure.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:smoke": "node scripts/smoke-self-host.mjs",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.2",
    "ethers": "6.17.0",
    "lucide-react": "^1.31.0",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "recharts": "^3.8.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.6.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3"
  },
  "type": "module"
}
