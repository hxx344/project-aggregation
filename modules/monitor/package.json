{
  "name": "market-spread-monitor",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/run-server.mjs --dev",
    "build": "node scripts/build.mjs",
    "build:linux": "node scripts/build.mjs",
    "start:linux": "bash server/entrypoint.sh",
    "start": "node scripts/run-server.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit --project tsconfig.linux.json",
    "start:windows": "node --experimental-strip-types --env-file-if-exists=.env.linux server/linux.mjs"
  },
  "dependencies": {
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.2",
    "https-proxy-agent": "9.1.0",
    "lucide-react": "^1.31.0",
    "proxy-from-env": "2.1.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "recharts": "^3.8.0",
    "tailwind-merge": "3.6.0",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "14.0.0",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vite": "8.0.13"
  },
  "type": "module",
  "description": "Extensible oil and Hynix spread dashboards with persistent Linux monitoring"
}
