{
  "name": "market-spread-monitor",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/run-server.mjs --dev",
    "build": "node scripts/build.mjs",
    "build:linux": "node scripts/build.mjs",
    "start:linux": "bash server/entrypoint.sh",
    "start": "node scripts/run-server.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit --project tsconfig.linux.json",
    "start:windows": "node --experimental-strip-types --env-file-if-exists=.env.linux server/linux.mjs"
  },
  "dependencies": {
    "class-variance-authority": "catalog:",
    "clsx": "catalog:",
    "drizzle-orm": "catalog:",
    "https-proxy-agent": "9.1.0",
    "lucide-react": "catalog:",
    "proxy-from-env": "2.1.0",
    "radix-ui": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "recharts": "catalog:",
    "tailwind-merge": "catalog:",
    "ws": "catalog:"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@tailwindcss/postcss": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "drizzle-kit": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "14.0.0",
    "tailwindcss": "catalog:",
    "tw-animate-css": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "8.59.3",
    "vite": "catalog:"
  },
  "type": "module",
  "description": "Extensible oil and Hynix spread dashboards with persistent Linux monitoring"
}
