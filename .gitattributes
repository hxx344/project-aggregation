# Auto-detect text files and check them out with LF on every platform, so files
# copied from a Windows working tree (shell scripts, units, Python) still run on Linux.
* text=auto eol=lf

# Explicitly declare text files
*.md text
*.js text
*.mjs text
*.ts text
*.tsx text
*.json text
*.css text
*.html text
*.sh text eol=lf
*.bash text eol=lf

# PowerShell scripts should use CRLF on Windows
*.ps1 text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.db binary
*.sqlite binary
*.sqlite3 binary

# Git hooks must keep LF on every platform (CRLF breaks the shebang in bash)
.githooks/* text eol=lf
