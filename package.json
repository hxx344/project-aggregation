{
  "name": "project-aggregation",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "统一项目工作台，聚合交易状态、市场监控与资产账本",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:server": "node --watch server/workbench.mjs",
    "check": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "build:bundle": "vite build",
    "install:modules": "node scripts/modules.mjs install",
    "build:modules": "node scripts/modules.mjs build",
    "build:all": "pnpm run build && pnpm run build:modules",
    "start": "node server/index.mjs",
    "test": "node --test tests/*.test.mjs",
    "pipeline": "node deploy/pipeline/cli.mjs",
    "pipeline:plan": "node deploy/pipeline/cli.mjs plan",
    "prepare": "node scripts/install-hooks.mjs"
  },
  "dependencies": {
    "ethers": "6.17.0",
    "lucide-react": "catalog:",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "react": "catalog:",
    "react-dom": "catalog:",
    "recharts": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "yaml": "2.9.1"
  },
  "packageManager": "pnpm@11.25.0"
}
